{
  "name": "flyrank-ai-decision-flow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "dev:inngest": "inngest-cli dev --no-discovery -u http://127.0.0.1:3002/api/inngest --port 8289",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "verify:integration": "tsx scripts/verify-integration.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "inngest": "4.22.0",
    "lucide-react": "^0.577.0",
    "openai": "7.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "shell-quote": "^1.11.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "inngest-cli": "1.46.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "8.3.3"
  }
}
