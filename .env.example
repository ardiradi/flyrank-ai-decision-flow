# Never put the OpenAI key in a VITE_* variable. The browser only talks to Express.
# Demo needs no key. For a free local model, follow LOCAL_LLM.md and use:
# OPENAI_API_KEY=local-no-key-required
# OPENAI_BASE_URL=http://127.0.0.1:8088/v1
# OPENAI_MODEL=qwen2.5-0.5b-instruct
OPENAI_API_KEY=
# Blank uses the SDK's hosted OpenAI endpoint; never use a hosted key with a local endpoint.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
PORT=3002
HOST=127.0.0.1
INNGEST_DEV=1
INNGEST_BASE_URL=http://127.0.0.1:8289
# Only needed when using Inngest Cloud, with INNGEST_DEV=0.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
